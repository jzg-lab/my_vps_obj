@@ -0,0 +1,90 @@
+import type { XtlsApi } from '@remnawave/xtls-sdk';
+import { ReceiverConfig } from '@remnawave/xtls-sdk/build/src/xray-protos/app/proxyman/config';
+
+import { XRAY_API_INBOUND_MODEL } from '@libs/contracts/constants/xray';
+
+export const IDENTITY_SCOPE_ERROR = 'Identity cancellation scope is unavailable or unsupported';
+
+export interface IdentityScope {
+    readonly apiTag: string;
+    readonly apiSocket: string;
+    readonly userTags: readonly string[];
+}
+
+export function createIdentityScope(
+    config: Record<string, unknown>,
+    socketPath: string,
+): IdentityScope {
+    const api = XRAY_API_INBOUND_MODEL({ xtlsApiSocketPath: socketPath });
+    if (!socketPath || !Array.isArray(config.inbounds) || config.inbounds.length === 0) {
+        throw new Error(IDENTITY_SCOPE_ERROR);
+    }
+    const tags = new Set<string>();
+    for (const value of config.inbounds as unknown[]) {
+        if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+            throw new Error(IDENTITY_SCOPE_ERROR);
+        }
+        const inbound = value as Record<string, unknown>;
+        if (
+            typeof inbound.tag !== 'string' ||
+            !inbound.tag ||
+            inbound.tag === api.tag ||
+            tags.has(inbound.tag) ||
+            inbound.protocol !== 'vless'
+        ) {
+            throw new Error(IDENTITY_SCOPE_ERROR);
+        }
+        tags.add(inbound.tag);
+    }
+    return { apiTag: api.tag, apiSocket: api.listen, userTags: [...tags] };
+}
+
+export async function listIdentityInbounds(
+    api: Pick<XtlsApi, 'handler'>,
+    scope: IdentityScope | null,
+): Promise<string[]> {
+    if (!scope) throw new Error(IDENTITY_SCOPE_ERROR);
+    try {
+        // Runtime settings may contain credentials: inspect, never log or retain the response.
+        const { inbounds } = await api.handler.rawClient.listInbounds({ isOnlyTags: false });
+        const seen = new Set<string>();
+        const users: string[] = [];
+        let managementVerified = false;
+        for (const inbound of inbounds) {
+            if (!inbound.tag || seen.has(inbound.tag)) throw new Error(IDENTITY_SCOPE_ERROR);
+            seen.add(inbound.tag);
+            if (inbound.tag === scope.apiTag) {
+                if (
+                    inbound.proxySettings?.type !== 'xray.proxy.dokodemo.Config' ||
+                    inbound.receiverSettings?.type !== ReceiverConfig.$type
+                ) {
+                    throw new Error(IDENTITY_SCOPE_ERROR);
+                }
+                const receiver = ReceiverConfig.decode(inbound.receiverSettings.value);
+                if (
+                    receiver.listen?.domain !== scope.apiSocket ||
+                    receiver.listen.ip !== undefined ||
+                    receiver.portList !== undefined
+                ) {
+                    throw new Error(IDENTITY_SCOPE_ERROR);
+                }
+                managementVerified = true;
+            } else {
+                if (inbound.proxySettings?.type !== 'xray.proxy.vless.inbound.Config') {
+                    throw new Error(IDENTITY_SCOPE_ERROR);
+                }
+                users.push(inbound.tag);
+            }
+        }
+        if (
+            !managementVerified ||
+            users.length === 0 ||
+            scope.userTags.some((tag) => !seen.has(tag))
+        ) {
+            throw new Error(IDENTITY_SCOPE_ERROR);
+        }
+        return users;
+    } catch {
+        throw new Error(IDENTITY_SCOPE_ERROR);
+    }
+}

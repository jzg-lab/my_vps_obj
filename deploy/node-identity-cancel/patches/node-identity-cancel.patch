+++ b/src/modules/handler/identity-cancel.ts
@@ -0,0 +1,27 @@
+import type { XtlsApi } from '@remnawave/xtls-sdk';
+import type { ISdkResponse } from '@remnawave/xtls-sdk/build/src/common/types';
+import type { RemoveUserResponseModel } from '@remnawave/xtls-sdk/build/src/handler/models';
+import { RemoveUserOperation } from '@remnawave/xtls-sdk/build/src/xray-protos/app/proxyman/command/command';
+
+export const IDENTITY_CANCEL_ERROR = 'Identity cancellation failed or is unsupported';
+
+export async function removeUserAndCancel(
+    api: Pick<XtlsApi, 'handler'>,
+    tag: string,
+    email: string,
+): Promise<ISdkResponse<RemoveUserResponseModel>> {
+    try {
+        await api.handler.rawClient.alterInbound({
+            tag,
+            operation: {
+                type: 'xray.app.proxyman.command.RemoveUserAndCancelOperation',
+                // Both messages have exactly one string field, email = 1.
+                value: RemoveUserOperation.encode(RemoveUserOperation.create({ email })).finish(),
+            },
+        });
+        return { isOk: true };
+    } catch {
+        // Never fall back to IP destruction or expose the gRPC request/identity.
+        return { isOk: false, message: IDENTITY_CANCEL_ERROR };
+    }
+}

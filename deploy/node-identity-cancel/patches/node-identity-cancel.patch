@@ -0,0 +1,173 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const Module = require('node:module');
+const ts = require('typescript');
+
+// Exercise real service code, with only process/native boundaries replaced offline.
+const root = path.resolve(__dirname, '..');
+const originalLoad = Module._load;
+Module._load = function (request, parent, isMain) {
+    if (request === 'sockdestroy') return { hasCapNetAdmin: () => true };
+    if (request === '@common/utils/get-system-stats') {
+        return { getSystemInfo: () => ({}), getSystemStats: () => ({}) };
+    }
+    for (const [alias, directory] of [
+        ['@common/', 'src/common/'],
+        ['@libs/contracts/', 'libs/contract/'],
+        ['@integration-modules/', 'src/integration-modules/'],
+    ]) {
+        if (request.startsWith(alias))
+            request = path.join(root, directory, request.slice(alias.length));
+    }
+    return originalLoad.call(this, request, parent, isMain);
+};
+Module._extensions['.ts'] = (module, filename) => {
+    const { outputText } = ts.transpileModule(fs.readFileSync(filename, 'utf8'), {
+        compilerOptions: {
+            module: ts.ModuleKind.CommonJS,
+            target: ts.ScriptTarget.ES2022,
+            experimentalDecorators: true,
+            emitDecoratorMetadata: true,
+            esModuleInterop: true,
+        },
+    });
+    module._compile(outputText, filename);
+};
+require('@nestjs/common').Logger.overrideLogger(false);
+const { HandlerService } = require('../src/modules/handler/handler.service.ts');
+const { InternalService } = require('../src/modules/internal/internal.service.ts');
+const { errorHandler } = require('../src/common/helpers/error-handler.helper.ts');
+const { createIdentityScope } = require('../src/common/utils/identity-scope.ts');
+const { ReceiverConfig } = require('@remnawave/xtls-sdk/build/src/xray-protos/app/proxyman/config');
+const {
+    ListInboundsResponse,
+    RemoveUserOperation,
+} = require('@remnawave/xtls-sdk/build/src/xray-protos/app/proxyman/command/command');
+
+const SOCKET = 'uc2-offline-api';
+const API_TAG = 'REMNAWAVE_API_INBOUND';
+const VLESS = 'xray.proxy.vless.inbound.Config';
+function runtimeInbound(tag, type = VLESS) {
+    return { tag, proxySettings: { type, value: new Uint8Array() } };
+}
+function apiInbound(socket = `@${SOCKET}`) {
+    return {
+        ...runtimeInbound(API_TAG, 'xray.proxy.dokodemo.Config'),
+        receiverSettings: {
+            type: ReceiverConfig.$type,
+            value: ReceiverConfig.encode(
+                ReceiverConfig.create({ listen: { domain: socket } }),
+            ).finish(),
+        },
+    };
+}
+function config(tags = ['inbound-a', 'inbound-b']) {
+    return {
+        inbounds: tags.map((tag) => ({
+            tag,
+            protocol: 'vless',
+            settings: { clients: [{ id: 'hash-target' }] },
+        })),
+    };
+}
+function expectHttpFailure(result) {
+    assert.equal(result.isOk, false);
+    assert.throws(
+        () => errorHandler(result),
+        (error) => error.getStatus() === 500,
+    );
+}
+async function fixture(fail = () => false, tags = ['inbound-a', 'inbound-b']) {
+    const calls = { precise: [], legacy: [], removed: [], added: [], events: [], lists: 0 };
+    const hooks = {};
+    const state = { inbounds: [apiInbound(), ...tags.map((tag) => runtimeInbound(tag))] };
+    const internal = new InternalService();
+    for (const tag of tags) await internal.addUserToInbound(tag, 'hash-target');
+    const remove = internal.removeUserFromInbound.bind(internal);
+    internal.removeUserFromInbound = async (tag, id) => {
+        calls.removed.push([tag, id]);
+        await remove(tag, id);
+    };
+    const api = {
+        handler: {
+            rawClient: {
+                async listInbounds(request) {
+                    assert.deepEqual(request, { isOnlyTags: false });
+                    calls.lists++;
+                    await hooks.list?.();
+                    return ListInboundsResponse.decode(
+                        ListInboundsResponse.encode(ListInboundsResponse.create(state)).finish(),
+                    );
+                },
+                async alterInbound(request) {
+                    assert.equal(
+                        request.operation.type,
+                        'xray.app.proxyman.command.RemoveUserAndCancelOperation',
+                    );
+                    const email = RemoveUserOperation.decode(request.operation.value).email;
+                    calls.precise.push([request.tag, email]);
+                    await hooks.alter?.(request.tag, email);
+                    if (fail(request.tag, email)) throw new Error('private request must not leak');
+                    return {};
+                },
+            },
+            async getInboundUsers() {
+                assert.fail('admission inventory cannot prove no old streams');
+            },
+            async removeUser(tag, email) {
+                calls.legacy.push([tag, email]);
+                return { isOk: true };
+            },
+            async addVlessUser(user) {
+                calls.added.push(user);
+                await hooks.add?.(user);
+                return { isOk: true };
+            },
+        },
+        stats: {
+            async getSysStats() {
+                return { isOk: true };
+            },
+            rawClient: {
+                async getStatsOnlineIpList() {
+                    assert.fail('must not inspect IPs');
+                },
+            },
+        },
+    };
+    const service = new HandlerService(api, internal, {
+        publish: (event) => calls.events.push(event),
+    });
+    await internal.confirmIdentityScope(createIdentityScope(config(tags), SOCKET), api);
+    return { service, internal, api, calls, hooks, state, tags: internal.getXtlsConfigInbounds() };
+}
+const removal = { username: 'target', hashData: { vlessUuid: 'hash-target' } };
+const addition = (rotation = false) => ({
+    data: [{ tag: 'inbound-a', type: 'vless', username: 'target', uuid: 'new-test-id' }],
+    hashData: { vlessUuid: 'new-test-id', ...(rotation ? { prevVlessUuid: 'old-test-id' } : {}) },
+});
+const bulkAddition = () => ({
+    affectedInboundTags: ['inbound-a'],
+    users: [
+        {
+            userData: { userId: 'target', hashUuid: 'hash-target', vlessUuid: 'new-test-id' },
+            inboundData: [{ tag: 'inbound-a', type: 'vless' }],
+        },
+    ],
+});
+module.exports = {
+    fixture,
+    expectHttpFailure,
+    removal,
+    addition,
+    bulkAddition,
+    config,
+    createIdentityScope,
+    apiInbound,
+    runtimeInbound,
+    ReceiverConfig,
+    API_TAG,
+    SOCKET,
+    VLESS,
+};

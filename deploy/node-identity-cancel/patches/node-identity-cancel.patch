+const assert = require('node:assert/strict');
+const test = require('node:test');
+const { fixture, expectHttpFailure, removal, addition } = require('./identity-fixture.cjs');
+
+test('single revoke waits for precise operation on every inbound, never emits IP kill', async () => {
+    const { service, calls } = await fixture();
+    assert.equal((await service.removeUser(removal)).response.success, true);
+    assert.deepEqual(calls.precise, [
+        ['inbound-a', 'target'],
+        ['inbound-b', 'target'],
+    ]);
+    assert.equal(calls.removed.length, 2);
+    assert.equal(calls.legacy.length, 0);
+    assert.equal(calls.events.length, 0);
+});
+
+test('one unsupported inbound is failure; only confirmed removals update mapping', async () => {
+    const { service, calls } = await fixture((tag) => tag === 'inbound-b');
+    const result = await service.removeUser(removal);
+    expectHttpFailure(result);
+    assert.deepEqual(calls.removed, [['inbound-a', 'hash-target']]);
+    assert.equal(calls.precise.length, 2);
+    assert.equal(calls.events.length, 0);
+    assert.doesNotMatch(JSON.stringify(result), /private request/);
+});
+
+test('unpatched or unavailable core fails without legacy or IP fallback', async () => {
+    const { service, calls } = await fixture(() => true);
+    expectHttpFailure(await service.removeUser(removal));
+    assert.equal(calls.removed.length, 0);
+    assert.equal(calls.legacy.length, 0);
+    assert.equal(calls.events.length, 0);
+});
+
+test('bulk revoke preserves partial failure across all identities and inbounds', async () => {
+    const { service, calls } = await fixture(
+        (tag, email) => tag === 'inbound-b' && email === 'second',
+    );
+    const result = await service.removeUsers({
+        users: [
+            { userId: 'target', hashUuid: 'hash-target' },
+            { userId: 'second', hashUuid: 'hash-second' },
+        ],
+    });
+    expectHttpFailure(result);
+    assert.equal(calls.precise.length, 4);
+    assert.equal(calls.removed.length, 3);
+    assert.equal(calls.events.length, 0);
+});
+
+test('bulk revoke succeeds only after all precise operations succeed', async () => {
+    const { service, calls } = await fixture();
+    assert.equal(
+        (await service.removeUsers({ users: [{ userId: 'target', hashUuid: 'hash-target' }] }))
+            .response.success,
+        true,
+    );
+    assert.equal(calls.precise.length, 2);
+    assert.equal(calls.events.length, 0);
+});
+
+test('credential rotation uses precise revoke before add', async () => {
+    const { service, calls } = await fixture();
+    assert.equal((await service.addUser(addition(true))).response.success, true);
+    assert.equal(calls.precise.length, 2);
+    assert.equal(calls.legacy.length, 0);
+    assert.equal(calls.added.length, 1);
+    assert.equal(calls.events.length, 0);
+});
+
+test('failed rotation does not add or claim completed removal', async () => {
+    const { service, calls } = await fixture(() => true);
+    expectHttpFailure(await service.addUser(addition(true)));
+    assert.equal(calls.added.length, 0);
+    assert.equal(calls.removed.length, 0);
+    assert.equal(calls.events.length, 0);
+});
+
+test('ordinary add and bulk sync retain upstream non-disconnecting operations', async () => {
+    const { service, calls } = await fixture();
+    assert.equal((await service.addUser(addition(false))).response.success, true);
+    assert.equal(
+        (
+            await service.addUsers({
+                affectedInboundTags: ['inbound-a'],
+                users: [
+                    {
+                        userData: {
+                            userId: 'target',
+                            hashUuid: 'hash-target',
+                            vlessUuid: 'new-test-id',
+                        },
+                        inboundData: [{ tag: 'inbound-a', type: 'vless' }],
+                    },
+                ],
+            })
+        ).response.success,
+        true,
+    );
+    assert.equal(calls.legacy.length, 4);
+    assert.equal(calls.precise.length, 0);
+    assert.equal(calls.events.length, 0);
+});
+
+test('disconnect-only identity endpoint explicitly refuses unsupported operation', async () => {
+    const { service, calls } = await fixture();
+    expectHttpFailure(await service.dropUsersConnections({ userIds: ['target'] }));
+    assert.equal(calls.events.length, 0);
+    assert.equal(calls.precise.length, 0);
+});
+
+test('explicit IP maintenance endpoint remains explicit', async () => {
+    const { service, calls } = await fixture();
+    assert.equal((await service.dropIps({ ips: ['192.0.2.1'] })).response.success, true);
+    assert.deepEqual(calls.events[0].ips, ['192.0.2.1']);
+    assert.equal(calls.precise.length, 0);
+});
+
+test('last-user removal permits a verified repeat through real handler inventory', async () => {
+    const { service, internal, calls } = await fixture(() => false, ['inbound-a']);
+    assert.equal((await service.removeUser(removal)).response.success, true);
+    assert.equal(internal.getXtlsConfigInbounds().size, 0);
+    assert.equal((await service.removeUser(removal)).response.success, true);
+    assert.equal(
+        (await service.removeUsers({ users: [{ userId: 'target', hashUuid: 'hash-target' }] }))
+            .response.success,
+        true,
+    );
+    assert.deepEqual(
+        calls.precise,
+        Array.from({ length: 3 }, () => ['inbound-a', 'target']),
+    );
+});
+
+test('unconfirmed configuration fails before any cancellation', async () => {
+    const { service, internal, calls } = await fixture();
+    internal.invalidateIdentityScope();
+    expectHttpFailure(await service.removeUser(removal));
+    expectHttpFailure(
+        await service.removeUsers({ users: [{ userId: 'target', hashUuid: 'hash-target' }] }),
+    );
+    assert.equal(calls.precise.length, 0);
+    assert.equal(calls.events.length, 0);
+});

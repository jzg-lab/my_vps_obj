+++ b/test/identity-scope.test.cjs
@@ -0,0 +1,442 @@
+const assert = require('node:assert/strict');
+const test = require('node:test');
+const { setImmediate: nextTurn } = require('node:timers/promises');
+const {
+    fixture,
+    expectHttpFailure,
+    removal,
+    addition,
+    bulkAddition,
+    config,
+    createIdentityScope,
+    apiInbound,
+    runtimeInbound,
+    ReceiverConfig,
+    API_TAG,
+    SOCKET,
+} = require('./identity-fixture.cjs');
+
+function barrier() {
+    const entered = Promise.withResolvers();
+    const released = Promise.withResolvers();
+    return {
+        entered: entered.promise,
+        release: released.resolve,
+        wait: async () => {
+            entered.resolve();
+            await released.promise;
+        },
+    };
+}
+
+function xrayFixture(f) {
+    const { XrayService } = require('../src/modules/xray-core/xray.service.ts');
+    const { HashedSet } = require('@remnawave/hashed-set');
+    const calls = { starts: 0, stops: 0, prepare: 0 };
+    const hooks = {};
+    const request = (tags = ['inbound-a', 'inbound-b']) => ({
+        internals: {
+            forceRestart: true,
+            hashes: {
+                emptyConfig: 'offline-config',
+                inbounds: tags.map((tag) => ({
+                    tag,
+                    usersCount: 1,
+                    hash: new HashedSet(['hash-target']).hash64String,
+                })),
+            },
+        },
+        xrayConfig: config(tags),
+    });
+    const service = new XrayService(
+        f.api,
+        {
+            async stop() {
+                calls.stops++;
+                await hooks.stop?.();
+            },
+            async start() {
+                calls.starts++;
+                await hooks.start?.();
+                const generated = await f.internal.getXrayConfig();
+                f.state.inbounds = [
+                    apiInbound(),
+                    ...generated.inbounds
+                        .filter((i) => i.tag !== API_TAG)
+                        .map((i) => runtimeInbound(i.tag)),
+                ];
+            },
+            async getStatus() {
+                return { up: true, pid: 123, raw: '' };
+            },
+            async getCoreVersion() {
+                return { semver: '26.7.28' }.semver;
+            },
+        },
+        { async prepare() {} },
+        {
+            async prepare() {
+                calls.prepare++;
+                await hooks.prepare?.();
+            },
+        },
+        {
+            async sync() {
+                return { error: null };
+            },
+            async stop() {},
+        },
+        f.internal,
+        {
+            getOrThrow(key) {
+                return {
+                    INTERNAL_SOCKET_PATH: 'offline-node',
+                    INTERNAL_REST_TOKEN: 'offline-test-only',
+                    XTLS_API_SOCKET_PATH: SOCKET,
+                    DISABLE_HASHED_SET_CHECK: false,
+                }[key];
+            },
+        },
+        {
+            async execute(query) {
+                return query.constructor.name === 'GetTorrentBlockerStateQuery'
+                    ? { enabled: false, includeRuleTags: new Set(), rulePosition: 0 }
+                    : {};
+            },
+        },
+        { async execute() {} },
+    );
+    return { service, calls, hooks, request };
+}
+
+test('nonempty incomplete registry cannot hide a real inbound, including API-like user names', async () => {
+    const f = await fixture();
+    f.tags.delete('inbound-b');
+    f.state.inbounds.push(runtimeInbound('REMNAWAVE_API'));
+    assert.equal((await f.service.removeUser(removal)).response.success, true);
+    assert.deepEqual(
+        f.calls.precise.map(([tag]) => tag),
+        ['inbound-a', 'inbound-b', 'REMNAWAVE_API'],
+    );
+});
+
+test('empty registry still covers all real inbounds for credential rotation', async () => {
+    const f = await fixture();
+    f.tags.clear();
+    assert.equal((await f.service.addUser(addition(true))).response.success, true);
+    assert.deepEqual(
+        f.calls.precise.map(([tag]) => tag),
+        ['inbound-a', 'inbound-b'],
+    );
+});
+
+const invalidRuntime = [
+    [
+        'API protocol spoof',
+        (rows) => {
+            rows[0].proxySettings.type = 'xray.proxy.vless.inbound.Config';
+        },
+    ],
+    [
+        'API socket spoof',
+        (rows) => {
+            rows[0] = apiInbound('@wrong');
+        },
+    ],
+    [
+        'API receiver type spoof',
+        (rows) => {
+            rows[0].receiverSettings.type = 'wrong';
+        },
+    ],
+    [
+        'malformed API receiver',
+        (rows) => {
+            rows[0].receiverSettings.value = Uint8Array.of(255);
+        },
+    ],
+    [
+        'API TCP port',
+        (rows) => {
+            rows[0].receiverSettings.value = ReceiverConfig.encode(
+                ReceiverConfig.create({
+                    listen: { domain: `@${SOCKET}` },
+                    portList: { range: [{ from: 1, to: 1 }] },
+                }),
+            ).finish();
+        },
+    ],
+    [
+        'missing API',
+        (rows) => {
+            rows.shift();
+        },
+    ],
+    [
+        'unknown protocol',
+        (rows) => {
+            rows.push(runtimeInbound('unknown', 'xray.proxy.trojan.ServerConfig'));
+        },
+    ],
+    [
+        'untagged handler',
+        (rows) => {
+            rows.push(runtimeInbound(''));
+        },
+    ],
+    [
+        'duplicate handler',
+        (rows) => {
+            rows.push(runtimeInbound('inbound-a'));
+        },
+    ],
+    [
+        'missing expected user inbound',
+        (rows) => {
+            rows.pop();
+        },
+    ],
+    [
+        'only API',
+        (rows) => {
+            rows.splice(1);
+        },
+    ],
+    [
+        'empty inventory',
+        (rows) => {
+            rows.splice(0);
+        },
+    ],
+];
+for (const [name, mutate] of invalidRuntime) {
+    test(`${name} fails before any revoke and invalidates readiness`, async () => {
+        const f = await fixture();
+        mutate(f.state.inbounds);
+        expectHttpFailure(await f.service.removeUser(removal));
+        assert.equal(f.calls.precise.length, 0);
+        const lists = f.calls.lists;
+        expectHttpFailure(await f.service.addUser(addition()));
+        assert.equal(f.calls.lists, lists);
+        assert.equal(f.calls.added.length, 0);
+    });
+}
+
+test('list failure is sanitized and never falls back to local registration', async () => {
+    const f = await fixture();
+    f.hooks.list = async () => {
+        throw new Error('secret runtime payload');
+    };
+    const result = await f.service.removeUser(removal);
+    expectHttpFailure(result);
+    assert.doesNotMatch(JSON.stringify(result), /secret runtime/);
+    assert.equal(f.calls.precise.length, 0);
+});
+
+test('original profile cannot claim the injected tag, unknown protocol, duplicate or untagged scope', () => {
+    for (const inbounds of [
+        [{ tag: API_TAG, protocol: 'vless' }],
+        [{ tag: 'a', protocol: 'trojan' }],
+        [{ tag: '', protocol: 'vless' }],
+        [
+            { tag: 'a', protocol: 'vless' },
+            { tag: 'a', protocol: 'vless' },
+        ],
+        [],
+    ])
+        assert.throws(() => createIdentityScope({ inbounds }, SOCKET), /scope is unavailable/);
+});
+
+const writes = [
+    ['add', (f) => f.service.addUser(addition())],
+    ['rotate', (f) => f.service.addUser(addition(true))],
+    ['bulk add', (f) => f.service.addUsers(bulkAddition())],
+    ['remove', (f) => f.service.removeUser(removal)],
+    [
+        'bulk remove',
+        (f) => f.service.removeUsers({ users: [{ userId: 'target', hashUuid: 'hash-target' }] }),
+    ],
+];
+for (const [name, write] of writes) {
+    test(
+        `${name} cannot interleave between inventory and precise cancellation`,
+        { timeout: 5000 },
+        async () => {
+            const f = await fixture();
+            const paused = barrier();
+            f.hooks.list = paused.wait;
+            const revoke = f.service.removeUser(removal);
+            await paused.entered;
+            const lists = f.calls.lists;
+            const other = write(f);
+            try {
+                await nextTurn();
+                assert.equal(f.calls.lists, lists);
+                assert.equal(f.calls.added.length, 0);
+                assert.equal(f.calls.precise.length, 0);
+            } finally {
+                paused.release();
+            }
+            assert.equal((await revoke).response.success, true);
+            assert.equal((await other).response.success, true);
+        },
+    );
+}
+
+test('a revoke waits until an in-flight add finishes', { timeout: 5000 }, async () => {
+    const f = await fixture();
+    const paused = barrier();
+    f.hooks.add = paused.wait;
+    const add = f.service.addUser(addition());
+    await paused.entered;
+    const revoke = f.service.removeUser(removal);
+    try {
+        await nextTurn();
+        assert.equal(f.calls.precise.length, 0);
+    } finally {
+        paused.release();
+    }
+    assert.equal((await add).response.success, true);
+    assert.equal((await revoke).response.success, true);
+});
+
+test(
+    'normal explicit start, restart and no-op confirmation remain available',
+    { timeout: 5000 },
+    async () => {
+        const f = await fixture();
+        const x = xrayFixture(f);
+        const body = x.request();
+        assert.equal((await x.service.startXray(body, 'offline')).response.isStarted, true);
+        assert.equal((await x.service.startXray(body, 'offline')).response.isStarted, true);
+        body.internals.forceRestart = false;
+        assert.equal((await x.service.startXray(body, 'offline')).response.isStarted, true);
+        assert.equal(x.calls.starts, 2);
+        assert.equal((await f.service.removeUser(removal)).response.success, true);
+    },
+);
+
+test(
+    'reload waits for the entire revoke before replacing configuration',
+    { timeout: 5000 },
+    async () => {
+        const f = await fixture();
+        const x = xrayFixture(f);
+        const paused = barrier();
+        f.hooks.alter = paused.wait;
+        const revoke = f.service.removeUser(removal);
+        await paused.entered;
+        const reload = x.service.startXray(x.request(['new-inbound']), 'offline');
+        try {
+            await nextTurn();
+            assert.equal(x.calls.stops, 0);
+            assert.equal(x.calls.prepare, 0);
+        } finally {
+            paused.release();
+        }
+        assert.equal((await revoke).response.success, true);
+        assert.equal((await reload).response.isStarted, true);
+        assert.deepEqual(
+            f.calls.precise.map(([tag]) => tag),
+            ['inbound-a', 'inbound-b'],
+        );
+    },
+);
+
+test('revoke during reload waits for the confirmed new inventory', { timeout: 5000 }, async () => {
+    const f = await fixture();
+    const x = xrayFixture(f);
+    const paused = barrier();
+    x.hooks.start = paused.wait;
+    const reload = x.service.startXray(x.request(['new-inbound']), 'offline');
+    await paused.entered;
+    const lists = f.calls.lists;
+    const revoke = f.service.removeUser(removal);
+    try {
+        await nextTurn();
+        assert.equal(f.calls.lists, lists);
+        assert.equal(f.calls.precise.length, 0);
+    } finally {
+        paused.release();
+    }

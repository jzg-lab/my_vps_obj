+}
+
+func TestIdentityCancelTypedOperation(t *testing.T) {
+	p := &cancelProxy{}
+	s := &handlerServer{ihm: cancelManager{handler: cancelHandler{p: p}}}
+	request := &AlterInboundRequest{Tag: "vless", Operation: serial.ToTypedMessage(&RemoveUserAndCancelOperation{Email: "target@example.test"})}
+	if _, err := s.AlterInbound(context.Background(), request); err != nil {
+		t.Fatal(err)
+	}
+	if p.email != "target@example.test" {
+		t.Fatal("wrong identity")
+	}
+}
+
+func TestIdentityCancelUnsupportedInbound(t *testing.T) {
+	for name, p := range map[string]proxy.Inbound{"trojan": new(trojan.Server), "shadowsocks": new(shadowsocks.Server)} {
+		t.Run(name, func(t *testing.T) {
+			s := &handlerServer{ihm: cancelManager{handler: cancelHandler{p: p}}}
+			_, err := s.AlterInbound(context.Background(), &AlterInboundRequest{Operation: serial.ToTypedMessage(&RemoveUserAndCancelOperation{Email: "target@example.test"})})
+			if err == nil {
+				t.Fatal("unsupported inbound reported success")
+			}
+		})
+	}
+}
+
+func TestIdentityCancelPropagatesFailure(t *testing.T) {
+	want := errors.New("revocation failed")
+	p := &cancelProxy{err: want}
+	err := (&RemoveUserAndCancelOperation{Email: "target@example.test"}).ApplyInbound(context.Background(), cancelHandler{p: p})
+	if !errors.Is(err, want) {
+		t.Fatalf("lost failure: %v", err)
+	}
+}
+
+func TestIdentityCancelUnknownOperationFails(t *testing.T) {
+	s := new(handlerServer)
+	_, err := s.AlterInbound(context.Background(), &AlterInboundRequest{Operation: &serial.TypedMessage{Type: "unsupported.identity.cancel"}})
+	if err == nil {
+		t.Fatal("unknown operation reported success")
+	}
+}

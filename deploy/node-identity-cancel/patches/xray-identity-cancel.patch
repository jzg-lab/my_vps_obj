+package mux
+
+import "context"
+
+type identityCancellationKey struct{}
+
+// ContextWithIdentityCancellation disallows XUDP's detached global sessions.
+// shortcut: XUDP migration needs identity ownership before it can be enabled here.
+func ContextWithIdentityCancellation(ctx context.Context) context.Context {
+	return context.WithValue(ctx, identityCancellationKey{}, true)
+}

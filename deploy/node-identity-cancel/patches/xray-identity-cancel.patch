new file mode 100644
index 0000000..0b8ca28
--- /dev/null
+++ b/proxy/vless/inbound/user_connections.go
@@ -0,0 +1,72 @@
+package inbound
+
+import (
+	"context"
+	stderrors "errors"
+	"net"
+	"strings"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/proxy/vless"
+)
+
+type userConnection struct {
+	cancel context.CancelFunc
+	conn   net.Conn
+}
+
+// trackConnection closes the authentication/removal race before any dispatch.
+func (h *Handler) trackConnection(ctx context.Context, user *protocol.MemoryUser, conn net.Conn) (context.Context, func(), error) {
+	h.usersMu.Lock()
+	defer h.usersMu.Unlock()
+	if h.validator.Get(user.Account.(*vless.MemoryAccount).ID.UUID()) != user {
+		return nil, nil, errors.New("identity cancellation: user was removed during authentication")
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	c := &userConnection{cancel: cancel, conn: conn}
+	email := strings.ToLower(user.Email)
+	if h.connections == nil {
+		h.connections = make(map[string]map[*userConnection]struct{})
+	}
+	if h.connections[email] == nil {
+		h.connections[email] = make(map[*userConnection]struct{})
+	}
+	h.connections[email][c] = struct{}{}
+	return ctx, func() {
+		cancel()
+		h.usersMu.Lock()
+		defer h.usersMu.Unlock()
+		delete(h.connections[email], c)
+		if len(h.connections[email]) == 0 {
+			delete(h.connections, email)
+		}
+	}, nil
+}
+
+// RemoveUserAndCancel revokes admission and closes all generations for this email
+// in this inbound. Ordinary RemoveUser keeps its upstream update semantics.
+func (h *Handler) RemoveUserAndCancel(ctx context.Context, email string) error {
+	if email == "" {
+		return errors.New("identity cancellation: email must not be empty")
+	}
+	h.usersMu.Lock()
+	defer h.usersMu.Unlock()
+	if user := h.validator.GetByEmail(email); user != nil {
+		if user.Account.(*vless.MemoryAccount).Reverse != nil {
+			return errors.New("identity cancellation: reverse proxy is not supported")
+		}
+		if err := h.validator.Del(email); err != nil {
+			return err
+		}
+	}
+	// Keep the admission lock until every close is issued, including repeat revokes.
+	var closeErrors []error
+	for c := range h.connections[strings.ToLower(email)] {
+		c.cancel()
+		if err := c.conn.Close(); err != nil && !stderrors.Is(err, net.ErrClosed) {
+			closeErrors = append(closeErrors, err)
+		}
+	}
+	return errors.Combine(closeErrors...)
+}

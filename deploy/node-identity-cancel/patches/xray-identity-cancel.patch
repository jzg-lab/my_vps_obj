+func TestIdentityCancelStreams(t *testing.T) {
+	for _, mode := range []string{"tcp", "udp", "mux-tcp", "mux-udp"} {
+		t.Run(mode, func(t *testing.T) {
+			h := testHandler(t)
+			target := testUser(t, h, "target@example.test")
+			sibling := testUser(t, h, "sibling@example.test")
+			a, b := openStream(t, h, target, mode), openStream(t, h, sibling, mode)
+			a.exchange(t, "before-target")
+			b.exchange(t, "before-sibling")
+			if strings.HasPrefix(mode, "mux") {
+				a.id = 2
+				b.id = 2
+				a.exchange(t, "second-target")
+				b.exchange(t, "second-sibling")
+			}
+			revoke(t, h, "TARGET@example.test")
+			expectEOF(t, a.conn)
+			b.exchange(t, "after-sibling")
+			if strings.HasPrefix(mode, "mux") {
+				b.id = 1
+				b.exchange(t, "first-sibling-still-open")
+			}
+			select {
+			case <-a.done:
+			case <-time.After(3 * time.Second):
+				t.Fatal("target handler leaked")
+			}
+			expectEOF(t, openStream(t, h, target, mode).conn)
+			openStream(t, h, sibling, mode).exchange(t, "new-sibling")
+			revoke(t, h, target.Email)
+			b.exchange(t, "after-idempotent-revoke")
+		})
+	}
+}

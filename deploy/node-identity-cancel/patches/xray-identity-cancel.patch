+func TestIdentityCancelConcurrentRegistration(t *testing.T) {
+	for range 200 {
+		h := testHandler(t)
+		u := testUser(t, h, "race@example.test")
+		a, b := gonet.Pipe()
+		start := make(chan struct{})
+		var wg sync.WaitGroup
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			<-start
+			ctx, release, err := h.trackConnection(context.Background(), u, a)
+			if err == nil {
+				defer release()
+				select {
+				case <-ctx.Done():
+				case <-time.After(3 * time.Second):
+					t.Error("accepted connection escaped revoke")
+				}
+			}
+		}()
+		go func() {
+			defer wg.Done()
+			<-start
+			if err := h.RemoveUserAndCancel(context.Background(), u.Email); err != nil {
+				t.Error(err)
+			}
+		}()
+		close(start)
+		wg.Wait()
+		a.Close()
+		b.Close()
+		if h.GetUser(context.Background(), u.Email) != nil {
+			t.Fatal("revoked identity can authenticate")
+		}
+		h.usersMu.Lock()
+		count := len(h.connections)
+		h.usersMu.Unlock()
+		if count != 0 {
+			t.Fatal("registry leaked")
+		}
+	}
+}

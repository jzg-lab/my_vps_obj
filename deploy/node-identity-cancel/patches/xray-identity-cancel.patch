+func TestIdentityCancelAuthenticationRace(t *testing.T) {
+	h := testHandler(t)
+	u := testUser(t, h, "race@example.test")
+	old := h.validator.Get(u.Account.(*vless.MemoryAccount).ID.UUID())
+	revoke(t, h, u.Email)
+	requireOK(t, h.AddUser(context.Background(), u))
+	a, b := gonet.Pipe()
+	defer a.Close()
+	defer b.Close()
+	if _, release, err := h.trackConnection(context.Background(), old, a); err == nil {
+		release()
+		t.Fatal("pre-removal authentication survived remove/readd")
+	}
+}

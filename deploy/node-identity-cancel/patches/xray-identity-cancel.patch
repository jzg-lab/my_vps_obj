+}
+
+func testHandler(t *testing.T) *Handler {
+	t.Helper()
+	p, err := apppolicy.New(context.Background(), &apppolicy.Config{})
+	requireOK(t, err)
+	return &Handler{validator: new(vless.MemoryValidator), policyManager: p}
+}
+
+func testUser(t *testing.T, h *Handler, email string) *protocol.MemoryUser {
+	t.Helper()
+	u := &protocol.MemoryUser{Email: email, Account: &vless.MemoryAccount{ID: protocol.NewID(uuid.New())}}
+	requireOK(t, h.AddUser(context.Background(), u))
+	return h.GetUser(context.Background(), email)
+}
+
+// In-memory transports share a source IP; no listening socket or external dial.
+type sameSourceConn struct{ gonet.Conn }
+
+func (c sameSourceConn) RemoteAddr() gonet.Addr {
+	return &gonet.TCPAddr{IP: gonet.IPv4(127, 0, 0, 1), Port: 10000}
+}
+
+type echoDispatcher struct{}
+
+func (*echoDispatcher) Type() interface{} { return routing.DispatcherType() }
+func (*echoDispatcher) Start() error      { return nil }
+func (*echoDispatcher) Close() error      { return nil }
+func (d *echoDispatcher) Dispatch(ctx context.Context, dest net.Destination) (*transport.Link, error) {
+	r, w := pipe.New(pipe.WithoutSizeLimit())
+	return &transport.Link{Reader: r, Writer: w}, nil
+}
+func (d *echoDispatcher) DispatchLink(ctx context.Context, dest net.Destination, link *transport.Link) error {
+	if dest.Address.String() == "v1.mux.cool" {
+		worker, err := mux.NewServerWorker(ctx, d, link)
+		if err != nil {
+			return err
+		}
+		select {
+		case <-ctx.Done():
+		case <-worker.WaitClosed():
+		}
+		return worker.Close()
+	}
+	return buf.Copy(link.Reader, link.Writer)
+}
+
+type testStream struct {
+	conn  gonet.Conn
+	done  chan error
+	mode  string
+	first bool
+	id    uint16
+	seen  map[uint16]bool
+}
+
+func openStream(t *testing.T, h *Handler, u *protocol.MemoryUser, mode string) *testStream {
+	t.Helper()
+	server, client := gonet.Pipe()
+	s := &testStream{conn: client, done: make(chan error, 1), mode: mode, first: true, id: 1, seen: make(map[uint16]bool)}
+	ctx := session.ContextWithInbound(context.Background(), &session.Inbound{Tag: "test", Source: net.TCPDestination(net.LocalHostIP, 10000)})
+	go func() {
+		err := h.Process(ctx, net.Network_TCP, sameSourceConn{server}, &echoDispatcher{})
+		server.Close()
+		s.done <- err
+	}()
+	t.Cleanup(func() { client.Close(); server.Close() })
+	requireOK(t, client.SetDeadline(time.Now().Add(3*time.Second)))
+	cmd := protocol.RequestCommandTCP
+	if mode == "udp" {
+		cmd = protocol.RequestCommandUDP
+	}
+	if strings.HasPrefix(mode, "mux") || mode == "xudp" {
+		cmd = protocol.RequestCommandMux
+	}
+	if mode == "reverse" {
+		cmd = protocol.RequestCommandRvs
+	}
+	var header bytes.Buffer
+	requireOK(t, encoding.EncodeRequestHeader(&header, &protocol.RequestHeader{Version: 0, User: u, Command: cmd, Address: net.LocalHostIP, Port: 443}, &encoding.Addons{}))
+	_, err := client.Write(header.Bytes())
+	requireOK(t, err)
+	return s
+}
+
+func (s *testStream) exchange(t *testing.T, payload string) {
+	t.Helper()
+	requireOK(t, s.conn.SetDeadline(time.Now().Add(3*time.Second)))
+	var packet bytes.Buffer
+	if strings.HasPrefix(s.mode, "mux") || s.mode == "xudp" {
+		dest := net.TCPDestination(net.LocalHostIP, 443)
+		if s.mode != "mux-tcp" {
+			dest.Network = net.Network_UDP
+		}
+		status := mux.SessionStatusKeep
+		if !s.seen[s.id] {
+			status = mux.SessionStatusNew
+		}
+		s.seen[s.id] = true
+		meta := mux.FrameMetadata{Target: dest, SessionID: s.id, SessionStatus: status, Option: mux.OptionData}
+		b := buf.New()
+		requireOK(t, meta.WriteTo(b))
+		packet.Write(b.Bytes())
+		b.Release()
+	}
+	if s.mode != "tcp" {
+		requireOK(t, binary.Write(&packet, binary.BigEndian, uint16(len(payload))))
+	}
+	packet.WriteString(payload)
+	_, err := s.conn.Write(packet.Bytes())
+	requireOK(t, err)
+	if s.first {
+		var response [2]byte
+		_, err = io.ReadFull(s.conn, response[:])
+		requireOK(t, err)
+		if response != [2]byte{} {
+			t.Fatalf("unexpected response header: %v", response)
+		}
+		s.first = false
+	}
+	if strings.HasPrefix(s.mode, "mux") {
+		var meta mux.FrameMetadata
+		requireOK(t, meta.Unmarshal(s.conn, false))
+		if meta.SessionID != s.id || !meta.Option.Has(mux.OptionData) {
+			t.Fatal("missing mux payload")
+		}
+	}
+	if s.mode != "tcp" {
+		var size uint16
+		requireOK(t, binary.Read(s.conn, binary.BigEndian, &size))
+		if int(size) != len(payload) {
+			t.Fatalf("payload size = %d", size)
+		}
+	}
+	got := make([]byte, len(payload))
+	_, err = io.ReadFull(s.conn, got)
+	requireOK(t, err)
+	if string(got) != payload {
+		t.Fatal("payload changed")
+	}
+}
+
+func expectEOF(t *testing.T, conn gonet.Conn) {
+	t.Helper()
+	if err := conn.SetReadDeadline(time.Now().Add(3 * time.Second)); err != nil && err != io.ErrClosedPipe {
+		t.Fatal(err)
+	}
+	var b [1]byte
+	n, err := conn.Read(b[:])
+	if n != 0 || err != io.EOF {
+		t.Fatalf("need actual EOF, got n=%d err=%v", n, err)
+	}
+}

+type closeFailureConn struct {
+	gonet.Conn
+	failure error
+}
+
+func (c closeFailureConn) Close() error { return c.failure }
+
+func TestIdentityCancelCloseFailureIsNotSuccess(t *testing.T) {
+	h := testHandler(t)
+	u := testUser(t, h, "close-failure@example.test")
+	a, b := gonet.Pipe()
+	defer a.Close()
+	defer b.Close()
+	want := stderrors.New("close failed")
+	ctx, release, err := h.trackConnection(context.Background(), u, closeFailureConn{a, want})
+	requireOK(t, err)
+	defer release()
+	if err := h.RemoveUserAndCancel(context.Background(), u.Email); err == nil {
+		t.Fatal("close failure reported success")
+	}
+	if ctx.Err() != context.Canceled {
+		t.Fatal("close failure prevented context cancellation")
+	}
+	if h.GetUser(context.Background(), u.Email) != nil {
+		t.Fatal("close failure restored admission")
+	}
+}

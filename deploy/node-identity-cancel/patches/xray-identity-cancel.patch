+func (op *RemoveUserAndCancelOperation) ApplyInbound(ctx context.Context, handler inbound.Handler) error {
+	p, err := getInbound(handler)
+	if err != nil {
+		return err
+	}
+	terminator, ok := p.(interface {
+		RemoveUserAndCancel(context.Context, string) error
+	})
+	if !ok {
+		return errors.New("identity cancellation is not supported by this inbound")
+	}
+	return terminator.RemoveUserAndCancel(ctx, op.Email)
+}
